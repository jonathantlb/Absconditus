[config]

application/config/name = "Absconditus"
application/config/version = "0.1.0"

config/name = "Absconditus"

display/window/size/videosync_mode = 1
display/window/size/windowed_width = 1280
display/window/size/windowed_height = 720
display/window/size/test_width = 1280
display/window/size/test_height = 720
display/window/title = "Absconditus"
display/window/resizable = true
display/window/borderless = false
display/window/maximized = false

rendering/renderer/rendering_method = "gl_compatibility"
rendering/quality/drivers/opengl_es3/load_default_fallbacks = true

input/mouse/capture_emulate_touch = false
